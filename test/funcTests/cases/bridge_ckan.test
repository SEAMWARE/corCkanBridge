#
# FILE            bridge_ckan.test
#
# Copyright 2026 Seamware
# SPDX-License-Identifier: Apache-2.0
#
# The ckan bridge's Channels: an endpoint <-> an entity attribute, both ways.
#
#   in    a value the device produces on an endpoint becomes the attribute's value, with the
#         device's time as observedAt - JSON as it is, or a JSON string for a 'text' Channel
#   out   a write to the attribute is sent to the endpoint
#   echo  the bridge's own write does not come back as a sample - samplesIn stays 0
#
# An endpoint the transport cannot carry ('../escape') is refused: the Channel stays, dormant, with
# the reason. The device is a directory of files (see src/ckanTransport.c).
#
# TODO: in a real bridge the device is the protocol's peer - a test server the INIT section starts
#       (corMqttBridge's tests start mosquitto) - and deviceWrite / deviceAwait talk to it.
#
--NAME--
ckan bridge - a value into an entity attribute and out again, no echo of its own writes

--TAGS--
bridge ckan

--INIT--
rm -rf "${CKAN_TEST_DIR:?}"
mkdir -p "$CKAN_TEST_DIR/device"
cat > $CKAN_TEST_DIR/bridges.json <<J
{ "ckan": { "server": { "dir": "$CKAN_TEST_DIR/device", "pollMs": 100 },
            "ngsild": { "topics": {
              "tank1/level":    { "entityId": "urn:ngsi-ld:Tank:T1", "entityType": "Tank", "attribute": "level" },
              "tank1/state":    { "entityId": "urn:ngsi-ld:Tank:T1", "entityType": "Tank", "attribute": "state",
                                  "channelInfo": [ { "key": "format", "value": "text" } ] },
              "tank1/setpoint": { "entityId": "urn:ngsi-ld:Tank:T1", "entityType": "Tank", "attribute": "setpoint" },
              "../escape":      { "entityId": "urn:ngsi-ld:Tank:T1", "entityType": "Tank", "attribute": "escape" } } } } }
J
brokerStart

--RUN--
echo "01. The device produces 42.5 on tank1/level, at 12:00 - the attribute follows, observedAt 12:00"
echo "=============================================================================================="
deviceWrite tank1/level 42.5 2026-10-01T12:00:00Z
entityAwait urn:ngsi-ld:Tank:T1 level '"level": 42.5'
entityGet urn:ngsi-ld:Tank:T1 level
echo
echo


echo "02. 'running' on tank1/state, a text Channel - a JSON string"
echo "============================================================="
deviceWrite tank1/state running
entityAwait urn:ngsi-ld:Tank:T1 state '"state": "running"'
entityGet urn:ngsi-ld:Tank:T1 state keyValues
echo
echo


echo "03. PATCH setpoint 70 - the device receives it on tank1/setpoint"
echo "================================================================="
attrPatch urn:ngsi-ld:Tank:T1 setpoint '{"value": 70}'
deviceAwait tank1/setpoint 70
echo
echo


echo "04. GET /channels - '../escape' dormant and why; setpoint sent once and not taken back in"
echo "=========================================================================================="
sleep 0.5                                             # five polls: time for an echo to show, were there one
channels
echo
echo


--TEARDOWN--
brokerStop
rm -rf "${CKAN_TEST_DIR:?}/device" "$CKAN_TEST_DIR/bridges.json"       # broker.log stays, for a failure

--EXPECT--
01. The device produces 42.5 on tank1/level, at 12:00 - the attribute follows, observedAt 12:00
==============================================================================================
{
  "id": "urn:ngsi-ld:Tank:T1",
  "level": {
    "observedAt": "2026-10-01T12:00:00Z",
    "type": "Property",
    "value": 42.5
  },
  "type": "Tank"
}


02. 'running' on tank1/state, a text Channel - a JSON string
=============================================================
{
  "id": "urn:ngsi-ld:Tank:T1",
  "state": "running",
  "type": "Tank"
}


03. PATCH setpoint 70 - the device receives it on tank1/setpoint
=================================================================
204
70


04. GET /channels - '../escape' dormant and why; setpoint sent once and not taken back in
==========================================================================================
../escape dormant samplesIn=0 samplesOut=0 - the bridge would not carry it: its address or channelInfo does not fit the transport
tank1/level available samplesIn=1 samplesOut=0
tank1/setpoint available samplesIn=0 samplesOut=1
tank1/state available samplesIn=1 samplesOut=0


