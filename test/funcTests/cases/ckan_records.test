  "id": "urn:ngsi-ld:District:Arlington",
  "name": {
    "type": "Property",
    "value": "Arlington"
  },
  "type": "District"
}


06. The DataChannel on GET /dataChannels - its mapping as the file wrote it, and no API key
========================================================================================
{
  "channelInfo": [
    {
      "key": "mode",
      "value": "once"
    },
    {
      "key": "pageSize",
      "value": "20"
    }
  ],
  "channelTarget": "44c931aa-4577-4caa-a8f2-ed1e38263e70",
  "id": "urn:ngsi-ld:DataChannel:ckan:44c931aa-4577-4caa-a8f2-ed1e38263e70",
  "idEncoding": "merge",
  "status": "available",
  "type": "DataChannel"
}
recordEntities: ['BikeStation', 'District']
the key on GET /dataChannels: 0
