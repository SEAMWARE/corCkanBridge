    "type": "Relationship"
  },
  "name": {
    "type": "Property",
    "value": "Railroad Lot and Minuteman Bikeway"
  },
  "type": "BikeStation"
}


05. 50 BikeStations, 2 Districts
=================================
BikeStation: 50
District:    2
urn:ngsi-ld:District:Arlington
urn:ngsi-ld:District:Boston
