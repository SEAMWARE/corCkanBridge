urn:ngsi-ld:District:Arlington
urn:ngsi-ld:District:Boston
{
  "id": "urn:ngsi-ld:District:Arlington",
  "name": {
    "observedAt": "<read time>",
    "type": "Property",
    "value": "Arlington"
  },
